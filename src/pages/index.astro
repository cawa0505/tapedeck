---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tapedeck — Linux-first media recorder</title>
    <style>
      :root {
        --bg: #ffffff;
        --bg-header: #fafafa;
        --fg: #1a1a1a;
        --fg-muted: #666666;
        --border: #e5e5e5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #111111;
          --bg-header: #161616;
          --fg: #e8e8e8;
          --fg-muted: #999999;
          --border: #2a2a2a;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, "Segoe UI", "Noto Sans TC", sans-serif;
        line-height: 1.6;
      }
      .container {
        max-width: 960px;
        margin: 0 auto;
        padding: 4rem 1.5rem 2rem;
      }
      .cta a {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.6rem 1.4rem;
        border-radius: 6px;
        background: #2f6feb;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <h1>tapedeck</h1>
      <p>Linux-first media recorder — 以 .roll 宣告式 DSL 驅動 TUI（vhs）與 GUI（niri/sway + wf-recorder）兩軌錄製。</p>
      <div class="cta">
        <a href="https://github.com/cawa0505/tapedeck">Get Started →</a>
      </div>
    </main>
    <Footer />
  </body>
</html>
