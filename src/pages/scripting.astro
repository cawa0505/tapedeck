---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>腳本語言 — tapedeck</title>
    <style>
      :root {
        --bg: #ffffff;
        --bg-header: #fafafa;
        --fg: #1a1a1a;
        --fg-muted: #666666;
        --border: #e5e5e5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #111111;
          --bg-header: #161616;
          --fg: #e8e8e8;
          --fg-muted: #999999;
          --border: #2a2a2a;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, "Segoe UI", "Noto Sans TC", sans-serif;
        line-height: 1.6;
      }
      .container {
        max-width: 960px;
        margin: 0 auto;
        padding: 4rem 1.5rem 2rem;
      }
      h1 { margin: 0 0 0.5rem; }
      .lede {
        color: var(--fg-muted);
        font-size: 1.05rem;
        margin-top: 0;
      }
      h2 {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        font-size: 1.3rem;
      }
      h3 { font-size: 1.05rem; margin-bottom: 0.6rem; }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.9em;
        background: var(--bg-header);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.05em 0.35em;
      }
      pre {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-header);
        padding: 1rem 1.25rem;
        overflow-x: auto;
      }
      pre code {
        display: block;
        background: none;
        border: none;
        padding: 0;
        font-size: 0.92rem;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
      }
      th, td {
        text-align: left;
        padding: 0.55rem 0.75rem;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
      }
      th {
        color: var(--fg-muted);
        font-weight: 600;
      }
      .note {
        color: var(--fg-muted);
        font-size: 0.92rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="container">
      <h1>腳本語言（.roll）</h1>
      <p class="lede">.roll 是 tapedeck 唯一的腳本語言，採兩層設計：<strong>輸入層</strong>描述錄製過程的操作，<strong>自動化層</strong>由 tapedeck 執行錄製前後處理。</p>

      <h2>總覽</h2>
      <p>執行後端由引擎決定：</p>
      <ul>
        <li><code>Set Engine Auto</code> — 自動偵測（TUI 腳本走 vhs、GUI 腳本走原生錄製）</li>
        <li><code>Set Engine VHS</code> — 終端機錄製（轉譯為 vhs 的 .tape 格式執行）</li>
        <li><code>Set Engine Native</code> — 視窗錄製（niri/sway + wf-recorder）</li>
      </ul>
      <p class="note">語法規格以 repo 內 openspec/specs/roll-dsl/ 為唯一依據，本頁為教學導覽。</p>

      <h2>檔案結構</h2>
      <p>.roll 是純文字檔，<code>#</code> 開頭的行為註解。典型的腳本分成兩部分：先是一段設定（引擎、輸出、影格率），接著才是錄製操作的指令流。舊寫法的檔案則以 <code>Title</code> → <code>Mode</code> → <code>Output</code> → <code>FPS</code> 的順序開頭：</p>
      <pre><code># examples/test_tui.roll（舊寫法，仍可解析）
Title "TUI Test"
Mode TUI
Output "test_tui.gif"
FPS 15

Type "echo Hello Tapedeck"
Enter
Sleep 1s</code></pre>
      <p class="note">新寫法建議用 <code>Set Engine</code> / <code>Set Output</code> / <code>Set Framerate</code>；舊寫法相容：Mode TUI（等同 Set Engine Auto）、Output、FPS、Terminal 仍可解析。</p>

      <h2>設定指令</h2>
      <table>
        <tr><th>指令</th><th>說明</th></tr>
        <tr><td><code>Set Engine &lt;Auto|VHS|Native&gt;</code></td><td>選擇執行引擎</td></tr>
        <tr><td><code>Set Output "路徑"</code></td><td>輸出檔路徑（副檔名決定格式）</td></tr>
        <tr><td><code>Set Framerate 15</code></td><td>影格率（vhs 用 <code>Set Framerate</code>，非 <code>Set FPS</code>）</td></tr>
        <tr><td><code>Set Shell "bash"</code></td><td>終端機 shell（vhs 後端用）</td></tr>
      </table>

      <h2>輸入層（錄製操作）</h2>
      <table>
        <tr><th>指令</th><th>說明</th><th>範例</th></tr>
        <tr><td><code>Type "文字"</code></td><td>輸入文字</td><td><code>Type "cargo run"</code></td></tr>
        <tr><td><code>Enter</code></td><td>按下 Enter</td><td><code>Enter</code></td></tr>
        <tr><td><code>Key &lt;按鍵&gt; [次數]</code></td><td>按指定鍵（Down/Up/Enter/Tab/q…）</td><td><code>Key Down 3</code>、<code>Key Tab</code></td></tr>
        <tr><td><code>Sleep 500ms</code></td><td>等待（可寫 <code>Sleep 1s</code>）</td><td><code>Sleep 300ms</code></td></tr>
        <tr><td><code>MouseMove x y [speed=smooth]</code></td><td>移動滑鼠</td><td><code>MouseMove 250 180 speed=smooth</code></td></tr>
        <tr><td><code>Click &lt;Left|Right|Middle&gt;</code></td><td>點擊</td><td><code>Click Left</code></td></tr>
        <tr><td><code>Shortcut "Ctrl+S"</code></td><td>組合鍵</td><td><code>Shortcut "Ctrl+S"</code></td></tr>
      </table>

      <h2>自動化層（tapedeck 執行）</h2>
      <table>
        <tr><th>指令</th><th>說明</th></tr>
        <tr><td><code>ExecBefore "指令"</code> / <code>ExecAfter "指令"</code></td><td>錄製前／後執行 shell 指令</td></tr>
        <tr><td><code>WaitWindow "標題" timeout=10s</code></td><td>等待視窗出現（逾時則中止）</td></tr>
        <tr><td><code>TargetWindow "標題"</code></td><td>鎖定要錄製的視窗</td></tr>
        <tr><td><code>WindowSize 寬 高</code></td><td>設定視窗尺寸</td></tr>
        <tr><td><code>Padding 20</code></td><td>錄製區域內縮</td></tr>
        <tr><td><code>Roll 15s</code></td><td>錄製時長</td></tr>
        <tr><td><code>Optimize &lt;codec&gt; [encoder=...]</code></td><td>錄製後轉換／優化</td></tr>
      </table>

      <h2>完整範例：GUI 自動化</h2>
      <p>把輸入層與自動化層合起來看——examples/gui_demo.roll 錄一段 Obsidian 操作：</p>
      <pre><code>Title "Obsidian Automation"
Set Engine Native
Set Output "assets/obsidian_demo.webm"

# 啟動 Obsidian
ExecBefore "obsidian"
WaitWindow "Obsidian" timeout=10s

# 視窗設定
TargetWindow "Obsidian"
WindowSize 1200 800
Padding 20

# 自動化操作
Roll 15s
MouseMove 500 300 speed=smooth
Sleep 300ms
Click Left
Type "New note for tapedeck demo"
Sleep 500ms
Shortcut "Ctrl+S"

# 結束並優化
ExecAfter "pkill obsidian"
Optimize AV1 encoder=av1_vaapi</code></pre>
      <p class="note">流程：先用 ExecBefore 啟動目標應用、WaitWindow 等視窗出現、TargetWindow 鎖定錄製對象；Roll 決定錄多久，中間穿插滑鼠與鍵盤操作；結束後 ExecAfter 收尾、Optimize 轉碼。</p>

      <h2>調試技巧</h2>
      <ol>
        <li>先乾跑確認解析與引擎選擇：<code>tapedeck run --dry-run script.roll</code></li>
        <li>錯誤訊息會指出腳本行號與失敗原因</li>
      </ol>

      <p>更多可以直接照抄的腳本，請看<a href="/examples/">範例庫</a>。</p>
    </main>
    <Footer />
  </body>
</html>
